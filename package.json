{
  "name": "dsh-plugin-account-balance",
  "version": "0.2.0",
  "description": "在会话状态行（conversation.composer.dock）显示已登录 DeepSeek 账号的余额",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "balance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zutomayo1/dsh-plugin-account-balance.git"
  },
  "homepage": "https://github.com/zutomayo1/dsh-plugin-account-balance#readme",
  "bugs": {
    "url": "https://github.com/zutomayo1/dsh-plugin-account-balance/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "test/smoke.cjs",
    "tools/probe-balance.mjs"
  ],
  "scripts": {
    "test": "node test/smoke.cjs",
    "probe": "node tools/probe-balance.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
